# ─── Brady Construction site — environment ──────────────────────────
# Copy to .env.local for development, or set in your host for production.

# PostgreSQL (docker-compose default matches this)
DATABASE_URL=postgres://brady:brady@localhost:5432/brady

# Public site URL — used for canonical URLs, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard credentials (CHANGE THESE)
ADMIN_EMAIL=admin@bradyremodel.com
ADMIN_PASSWORD=change-me-in-production
SESSION_SECRET=generate-a-long-random-string-here

# Lead email delivery — pick ONE provider:
# Option A: Resend (recommended, free tier)
RESEND_API_KEY=
# Option B: generic SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where lead notifications go + who they appear from
LEAD_EMAIL_TO=atbbrady@yahoo.com
LEAD_EMAIL_FROM="Brady Construction <leads@bradyremodel.com>"

# Search console verification tokens (meta tags) 
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
